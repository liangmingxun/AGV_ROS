<?xml version="1.0"?>
<package format="2">
  <name>multi_agv_analysis</name>
  <version>0.1.0</version>
  <description>Reproducible bag conversion, run validation and metrics for multi-AGV experiments.</description>

  <maintainer email="1579938689@qq.com">liangmingxun</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>agv_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rosbag</depend>
  <depend>rosgraph</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-yaml</test_depend>

  <export/>
</package>

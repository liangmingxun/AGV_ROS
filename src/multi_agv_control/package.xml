<?xml version="1.0"?>
<package format="2">
  <name>multi_agv_control</name>
  <version>0.1.0</version>
  <description>Arc-length paths and cooperative support geometry for the multi-AGV experiments.</description>

  <maintainer email="lijx0626@163.com">ljx</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>agv_msgs</depend>
  <build_depend>eigen</build_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <build_export_depend>eigen</build_export_depend>
  <exec_depend>eigen</exec_depend>

  <test_depend>gtest</test_depend>
  <test_depend>rosgraph</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>

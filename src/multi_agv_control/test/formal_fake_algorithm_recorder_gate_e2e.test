<launch>
  <include file="$(find multi_agv_bringup)/launch/formal_fake_algorithm.launch">
    <arg name="start_state_estimator" value="false"/>
    <arg name="require_recorder_armed" value="true"/>
  </include>
  <test test-name="formal_fake_algorithm_recorder_gate_e2e"
        pkg="multi_agv_control"
        type="test_formal_fake_algorithm_e2e.py"
        time-limit="30">
    <param name="exercise_recorder_gate" value="true"/>
  </test>
</launch>

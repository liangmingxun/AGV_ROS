<launch>
  <include file="$(find multi_agv_bringup)/launch/formal_fake_algorithm.launch">
    <arg name="upper_config" value="$(find multi_agv_bringup)/config/exp2b_M2b.yaml"/>
    <arg name="lower_config" value="$(find multi_agv_bringup)/config/exp2b_M2b.yaml"/>
    <arg name="path_config" value="$(find multi_agv_bringup)/config/path_circle_r0p7_cw_m1_r1.yaml"/>
    <arg name="runtime_config" value="$(find multi_agv_bringup)/config/formal_serial_m1_r1_circle_r0p7_short_arc_runtime.yaml"/>
    <arg name="start_state_estimator" value="false"/>
    <arg name="require_recorder_armed" value="true"/>
    <arg name="formal_available_wheel_limit" value="0.15"/>
  </include>
  <param name="/formal_fake_algorithm/formal_fake_runtime/target_progress" value="0.20"/>
  <test test-name="m2b_terminal_stop" pkg="multi_agv_control"
        type="test_formal_fake_algorithm_e2e.py" time-limit="30">
    <param name="exercise_terminal_stop" value="true"/>
  </test>
</launch>

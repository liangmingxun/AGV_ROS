<launch>
  <include file="$(find multi_agv_bringup)/launch/formal_fake_algorithm.launch">
    <arg name="upper_config"
         value="$(find multi_agv_bringup)/config/exp2a_M2a.yaml"/>
    <arg name="lower_config"
         value="$(find multi_agv_bringup)/config/exp3_R1.yaml"/>
    <arg name="start_state_estimator" value="false"/>
  </include>
  <test test-name="formal_fake_algorithm_m2a_r1_e2e"
        pkg="multi_agv_control"
        type="test_formal_fake_algorithm_e2e.py"
        time-limit="30">
    <param name="expected_method" value="M2a_R1"/>
  </test>
</launch>

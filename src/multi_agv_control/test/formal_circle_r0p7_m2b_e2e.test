<launch>
  <include file="$(find multi_agv_bringup)/launch/formal_fake_algorithm.launch">
    <arg name="upper_config"
         value="$(find multi_agv_bringup)/config/exp2b_M2b.yaml"/>
    <arg name="lower_config"
         value="$(find multi_agv_bringup)/config/exp2b_M2b.yaml"/>
    <arg name="path_config"
         value="$(find multi_agv_bringup)/config/path_circle_r0p7_cw_m1_r1.yaml"/>
    <arg name="runtime_config"
         value="$(find multi_agv_bringup)/config/formal_serial_m1_r1_circle_r0p7_short_arc_runtime.yaml"/>
    <arg name="start_state_estimator" value="false"/>
    <arg name="command_publication_authorized" value="true"/>
    <arg name="formal_available_wheel_limit" value="0.15"/>
  </include>
  <test test-name="formal_circle_r0p7_m2b_e2e"
        pkg="multi_agv_control"
        type="test_formal_fake_algorithm_e2e.py"
        time-limit="30">
    <param name="expected_method" value="M2b_M2b"/>
    <param name="expect_m2b_debug" value="true"/>
  </test>
</launch>

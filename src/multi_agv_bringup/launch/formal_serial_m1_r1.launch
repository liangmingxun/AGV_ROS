<launch>
  <!-- Connects to already-running serial chassis and camera-fused state. -->
  <arg name="upper_config"
       default="$(find multi_agv_bringup)/config/exp2a_M1_serial_008.yaml"/>
  <arg name="lower_config"
       default="$(find multi_agv_bringup)/config/exp3_R1.yaml"/>
  <arg name="runtime_config"
       default="$(find multi_agv_bringup)/config/formal_serial_m1_r1_runtime.yaml"/>
  <arg name="path_config"
       default="$(find multi_agv_bringup)/config/path_s_curve_terminal_straight.yaml"/>
  <arg name="authorization_config"
       default="$(find multi_agv_bringup)/config/formal_serial_m1_r1_authorization.yaml"/>
  <arg name="classic_additive_config"
       default="$(find multi_agv_bringup)/config/formal_serial_classic_additive_candidate_A_commissioning.yaml"/>
  <arg name="classic_additive_scale" default="0.25"/>
  <arg name="classic_additive_physical_enabled" default="false"/>
  <arg name="experiment_id" default="exp2a_m1_r1_unloaded_serial"/>
  <arg name="target_progress" default="1.2042352285"/>
  <arg name="enable_commands" default="false"/>
  <arg name="confirm_test_area_clear" default="false"/>
  <arg name="confirm_wheels_on_floor" default="false"/>
  <arg name="confirm_unloaded_30cm_fixture" default="false"/>
  <arg name="risk_disturbance_peak_fraction" default="0.30"/>
  <arg name="risk_disturbance_enabled" default="false"/>

  <node pkg="multi_agv_control" type="formal_algorithm_node"
        name="formal_algorithm" output="screen" required="true">
    <rosparam command="load" file="$(arg path_config)"/>
    <rosparam command="load"
              file="$(find multi_agv_bringup)/config/support_geometry.yaml"/>
    <rosparam command="load" file="$(arg runtime_config)"/>
    <rosparam command="load" file="$(arg upper_config)"/>
    <rosparam command="load" file="$(arg lower_config)"/>
    <rosparam command="load" file="$(arg authorization_config)"/>
    <rosparam command="load" file="$(arg classic_additive_config)"/>
    <param name="platform_transport_type" value="serial"/>
    <param name="formal_fake_runtime/command_publication_authorized"
           value="$(arg enable_commands)"/>
    <param name="formal_fake_runtime/require_recorder_armed" value="true"/>
    <param name="formal_fake_runtime/confirm_test_area_clear"
           value="$(arg confirm_test_area_clear)"/>
    <param name="formal_fake_runtime/confirm_wheels_on_floor"
           value="$(arg confirm_wheels_on_floor)"/>
    <param name="formal_fake_runtime/confirm_unloaded_30cm_fixture"
           value="$(arg confirm_unloaded_30cm_fixture)"/>
    <param name="formal_fake_runtime/experiment_id" value="$(arg experiment_id)"/>
    <param name="formal_fake_runtime/classic_additive_physical/qualification_scale"
           value="$(arg classic_additive_scale)"/>
    <param name="formal_fake_runtime/classic_additive_physical/enabled"
           value="$(arg classic_additive_physical_enabled)"/>
    <param name="formal_fake_runtime/target_progress" value="$(arg target_progress)"/>
    <param name="formal_fake_runtime/risk_disturbance_v1/peak_fraction"
           value="$(arg risk_disturbance_peak_fraction)"/>
    <param name="formal_fake_runtime/risk_disturbance_v1/enabled"
           value="$(arg risk_disturbance_enabled)"/>
  </node>
</launch>

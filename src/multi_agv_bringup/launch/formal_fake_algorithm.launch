<launch>
  <arg name="upper_config"
       default="$(find multi_agv_bringup)/config/exp2a_M1.yaml"/>
  <arg name="lower_config"
       default="$(find multi_agv_bringup)/config/exp3_R1.yaml"/>
  <arg name="runtime_config"
       default="$(find multi_agv_bringup)/config/formal_fake_runtime.yaml"/>
  <arg name="path_config"
       default="$(find multi_agv_bringup)/config/path_s_curve.yaml"/>
  <arg name="localization_config"
       default="$(find multi_agv_bringup)/config/localization_odom.yaml"/>
  <arg name="start_state_estimator" default="true"/>
  <arg name="require_recorder_armed" default="false"/>
  <arg name="command_publication_authorized" default="true"/>
  <arg name="formal_available_wheel_limit" default="0.08"/>
  <arg name="risk_disturbance_enabled" default="false"/>
  <arg name="risk_disturbance_peak_fraction" default="0.30"/>
  <arg name="risk_disturbance_experiment_id"
       default="exp2c_risk_disturbance_v1_fake"/>
  <arg name="risk_disturbance_target_progress" default="5.178229715025710"/>
  <arg name="yaw_drive_disturbance_enabled" default="false"/>
  <arg name="yaw_drive_disturbance_amplitude" default="0.004"/>
  <arg name="yaw_drive_disturbance_experiment_id"
       default="exp2c_v2_yaw_disturbance_fake"/>

  <include file="$(find multi_agv_bringup)/launch/three_fake_chassis.launch">
    <arg name="formal_available_wheel_limit"
         value="$(arg formal_available_wheel_limit)"/>
  </include>
  <include if="$(arg start_state_estimator)"
           file="$(find multi_agv_bringup)/launch/odom_state_estimator.launch">
    <arg name="path_config" value="$(arg path_config)"/>
    <arg name="localization_config" value="$(arg localization_config)"/>
  </include>

  <node pkg="multi_agv_control" type="formal_fake_algorithm_node"
        name="formal_fake_algorithm" output="screen" required="true">
    <rosparam command="load" file="$(arg path_config)"/>
    <rosparam command="load"
              file="$(find multi_agv_bringup)/config/support_geometry.yaml"/>
    <rosparam command="load" file="$(arg runtime_config)"/>
    <rosparam command="load" file="$(arg upper_config)"/>
    <rosparam command="load" file="$(arg lower_config)"/>
    <param name="platform_transport_type" value="fake"/>
    <param name="formal_fake_runtime/command_publication_authorized"
           value="$(arg command_publication_authorized)"/>
    <param name="formal_fake_runtime/require_recorder_armed"
           value="$(arg require_recorder_armed)"/>
    <param name="formal_fake_runtime/risk_disturbance_v1/enabled"
           value="$(arg risk_disturbance_enabled)"/>
    <param name="formal_fake_runtime/risk_disturbance_v1/peak_fraction"
           value="$(arg risk_disturbance_peak_fraction)"/>
    <param if="$(arg risk_disturbance_enabled)"
           name="formal_fake_runtime/experiment_id"
           value="$(arg risk_disturbance_experiment_id)"/>
    <param if="$(arg risk_disturbance_enabled)"
           name="formal_fake_runtime/target_progress"
           value="$(arg risk_disturbance_target_progress)"/>
    <param name="formal_fake_runtime/yaw_drive_disturbance_v2/enabled"
           value="$(arg yaw_drive_disturbance_enabled)"/>
    <param name="formal_fake_runtime/yaw_drive_disturbance_v2/amplitude"
           value="$(arg yaw_drive_disturbance_amplitude)"/>
    <param if="$(arg yaw_drive_disturbance_enabled)"
           name="formal_fake_runtime/experiment_id"
           value="$(arg yaw_drive_disturbance_experiment_id)"/>
  </node>
</launch>

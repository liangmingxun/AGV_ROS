<launch>
  <!-- Requires pose_provider and camera_odom_fusion to be running already. -->
  <arg name="path_config"
       default="$(find multi_agv_bringup)/config/path_s_curve.yaml"/>
  <arg name="runtime_config" default=""/>

  <node pkg="multi_agv_control" type="path_state_estimator_node"
        name="path_state_estimator" output="screen" required="true">
    <rosparam command="load" file="$(arg path_config)"/>
    <rosparam command="load"
              file="$(find multi_agv_bringup)/config/support_geometry.yaml"/>
    <rosparam command="load"
              file="$(find multi_agv_bringup)/config/localization_camera.yaml"/>
    <rosparam command="load"
              file="$(find multi_agv_bringup)/config/localization_camera_three_car_closed_loop.yaml"/>
    <!-- A formal run may overlay feedback conditioning without changing the
         frozen shared camera/localization configuration. -->
    <rosparam if="$(eval arg('runtime_config') != '')" command="load"
              file="$(arg runtime_config)"/>
  </node>
</launch>
